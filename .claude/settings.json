{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run check)",
      "Bash(npm run format)",
      "Bash(npx playwright test:*)",
      "Bash(npx prettier:*)",
      "Bash(npx vercel deploy)",
      "Bash(npx vercel whoami)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(npx vercel deploy --prod:*)",
      "Bash(npx vercel promote:*)",
      "Bash(npx vercel rollback:*)",
      "Bash(npx vercel env:*)",
      "Bash(git push:*)",
      "Bash(gh repo create:*)"
    ],
    "deny": ["Read(./.env*)", "Read(./.vercel/**)", "Bash(git push --force:*)", "Bash(git commit --no-verify:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-stop.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
