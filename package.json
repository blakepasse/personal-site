{
  "name": "blake-passe-site",
  "private": true,
  "type": "module",
  "description": "Personal site for Blake Passe. Static HTML/CSS/JS, deployed on Vercel.",
  "scripts": {
    "dev": "serve -l 8765 .",
    "format": "prettier --write .",
    "lint": "eslint . && html-validate index.html && prettier --check .",
    "test": "playwright test",
    "check": "npm run lint && npm run test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "html-validate": "^8.24.0",
    "prettier": "^3.3.3",
    "serve": "^14.2.4"
  }
}
